# Google Fonts developer API key (create one at https://console.cloud.google.com/apis/credentials with the Web Fonts Developer API enabled). Leave empty to hide the Google Fonts list.
VITE_GOOGLE_FONTS_API_KEY=

# Full public URL of the deployed app, with a trailing slash (for example https://example.com/hard-copy/). Used for canonical and social tags, robots.txt, and sitemap.xml. Leave empty to omit them.
VITE_SITE_URL=
